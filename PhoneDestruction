	local function autofarm2_fakescript() -- ScreenGui.autofarm
		local script = Instance.new("LocalScript", ScreenGui)
		script.Name = "autofarm"
		local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;:,.<>?"
		local name = ""
		local Loop
		local RunService = game:GetService("RunService")
		local connections = {}
		for i = 1, 10 do
			local randomIndex = math.random(1, #chars)
			name = name .. chars:sub(randomIndex, randomIndex)
		end
		script.Parent.Name = name
		local value = Instance.new("StringValue", script.Parent)
		value.Name = "CurrentMode"
		value.Value = ""
		local uis = game:GetService("UserInputService")
		local stats = game:GetService("Stats")
		local antifling = true
		local Players = game:GetService("Players")
		local localPlayer = Players.LocalPlayer
		local startpos = CFrame.new(87, -50, -92) * CFrame.Angles(0, math.rad(90), 0)
		local plate = Instance.new("Part", workspace)
		plate.Anchored = true
		plate.CanCollide = true
		plate.Size = Vector3.new(10, 1, 10)
		plate.Name = "plate"
		plate.Parent = workspace
		plate.Position = game.Players.LocalPlayer.Character.HumanoidRootPart.Position - Vector3.new(0,5,0)
		local platepos = plate.Position
		local function setupCharacterCollision(character)
			local function disableCollide(part)
				if antifling and part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
			for _, part in ipairs(character:GetChildren()) do
				disableCollide(part)
			end
			local childAddedConn = character.ChildAdded:Connect(disableCollide)
			local steppedConn = RunService.Stepped:Connect(function()
				if antifling and character:IsDescendantOf(workspace) then
					for _, part in ipairs(character:GetChildren()) do
						if part:IsA("BasePart") and part.CanCollide then
							part.CanCollide = false
						end
					end
				end
			end)
			character.Destroying:Connect(function()
				childAddedConn:Disconnect()
				steppedConn:Disconnect()
			end)
		end
		local function trackPlayer(player)
			if player == localPlayer then return end
			local charAddedConn = player.CharacterAdded:Connect(setupCharacterCollision)
			if player.Character then
				setupCharacterCollision(player.Character)
			end
			connections[player] = charAddedConn
		end
		local function untrackPlayer(player)
			if connections[player] then
				connections[player]:Disconnect()
				connections[player] = nil
			end
		end
		for _, player in ipairs(Players:GetPlayers()) do
			trackPlayer(player)
		end
		Players.PlayerAdded:Connect(trackPlayer)
		Players.PlayerRemoving:Connect(untrackPlayer)
		local Modes = {
			Xiaotu = {140, 4, 204},
			Apple = {-111, 4, -38},
			Samson = {-111, 4, -118},
			Googly = {-38, 4, 32}
		}
		local CurrentMode = nil
		repeat task.wait() until value.Value ~= ""
		function Unload()
			game.Players.LocalPlayer.Character
				:PivotTo(
					CFrame.new(game.Players.LocalPlayer.Character.HumanoidRootPart.Position 
						+ Vector3.new(0, 150, 0)))
			plate:Destroy()
			game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health = 0
			game:GetService("StarterGui")
				:SetCore("SendNotification", {
					Title = "farmer's ascent",
					Text = "unloaded",
					Duration = 5, -- Время отображения в секундах
					Button1 = "close"
				})
			task.wait()
			script.Parent.Unload:Destroy()
			task.wait()
			task.cancel(Loop) -- Полностью останавливает поток с циклом
			print(script.Parent)
			script.Parent.Parent = nil
			
		end
		CurrentMode = Modes[value.Value]
		game.Players.LocalPlayer.Character:PivotTo(startpos)
		plate.Position = game.Players.LocalPlayer.Character.HumanoidRootPart.Position - Vector3.new(0,5,0)
		local platepos = plate.Position
		script.Parent.Title.Visible = false
		script.Parent.GameName.Visible = false
		script.Parent.MainFrame.Visible = false
		script.Parent.Unload.Visible = true
		script.Parent.Unload.MouseButton1Click:Connect(Unload)
		wait(1)
		-----------------------------------
		--
		-- MAIN MAIN MAIN MAIN MAIN MAIN --
		--
		-----------------------------------
		Loop = task.spawn(function()
			while true do
				game:GetService("ReplicatedStorage").PhoneRemotes.SetRagdoll:FireServer(false)
				local vim = game:GetService("VirtualInputManager")
				-- Симулируем нажатие клавиши Q
				vim:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
				task.wait(0.05) -- Небольшая пауза (удержание клавиши)
				vim:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
				wait(1)
				local Event = game:GetService("ReplicatedStorage").PhoneRemotes.DropPhone
				local player = game:GetService("Players").LocalPlayer
				local character = player.Character
				if character and character.PrimaryPart then
					local function getPingSeconds()
						local pingMS = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
						return pingMS / 1000
					end
					-- 1. Получаем твой текущий CFrame
					local originalCFrame = character.PrimaryPart.CFrame
					-- 2. Рассчитываем целевой CFrame:
					-- Сначала поднимаем на 1000 студов вверх (по осям мира)
					-- Затем умножаем на CFrame.new(0, 0, -15), чтобы сместить на 15 студов ВПЕРЕД относительно твоего лица
					local targetCFrame = (originalCFrame + Vector3.new(0, math.random(550,575), 0)) * CFrame.new(math.random(147,153), 0, math.random(-150,0))
					local humanoid = character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
						humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
						humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
						-- Принудительно возвращаем персонажа в состояние бега/ходьбы
						humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
					end
					-- 3. Телепортируем персонажа целиком в рассчитанную точку
					character:PivotTo(targetCFrame * CFrame.Angles(math.rad(-85), 0, 0))
					game:GetService("ReplicatedStorage").PhoneRemotes.SetRagdoll:FireServer(false)
					plate.Position = character.PrimaryPart.Position - Vector3.new(0, 5, 0)
					plate.Size = Vector3.new(1, 1, 1)
					if character:FindFirstChild("HumanoidRootPart") then
						character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
					end
					local currentPing = getPingSeconds()
					local pingDelay = math.max(currentPing * 1.5, 0.05) -- Защита от нулевого пинга при старте
					-- 4. Задержка, чтобы сервер успел обновить твои координаты
					task.wait(pingDelay)
					-- 5. Отправляем ивент на сброс телефона
					Event:FireServer(targetCFrame)
					game:GetService("ReplicatedStorage").PhoneRemotes.SetRagdoll:FireServer(false)
					-- 6. Возвращаем тебя обратно на исходную позицию на земле
					game:GetService("RunService").Heartbeat:Wait()
					character:PivotTo(originalCFrame)
					plate.Position = platepos
					plate.Size = Vector3.new(10, 1, 10)
					game:GetService("ReplicatedStorage").PhoneRemotes.SetRagdoll:FireServer(false)
					if character:FindFirstChild("HumanoidRootPart") then
						character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
					end
					local Event = game:GetService("ReplicatedStorage").PhoneRemotes.PointsAwarded
					-- Скрипт останавливается здесь и ждет любого сигнала от этого события
					game:GetService("ReplicatedStorage").PhoneRemotes.SetRagdoll:FireServer(false)
					local eventReceived = false
					local startTime = os.clock()
					local timedOut = false
					-- 1. Подключаем временный слушатель с проверкой аргумента kind
					local connection
					connection = Event.OnClientEvent:Connect(function(data)
						-- Проверяем, что пришедшие данные это таблица и внутри лежит нужный тип
						if type(data) == "table" and data.kind == "explosion" then
							eventReceived = true -- Условие выполнено, выходим из ожидания
						else
						end
					end)
					-- 2. Ждем срабатывания нужного события или наступления таймаута (10 секунд)
					while not eventReceived do
						if (os.clock() - startTime) >= 10 then
							timedOut = true
							break -- Прерываем цикл, так как время вышло, а explosion не пришел
						end
						task.wait(0.1)
					end
